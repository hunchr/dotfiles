#!/usr/bin/env bash
# heroku config -sa <app> | deploio
set -euo pipefail

yaml=''

while IFS= read -r line; do
  key=$(echo "$line" | cut -d= -f1)
  value=$(echo "$line" | cut -d= -f2-)
  value=$([[ $value == \'* ]] && echo "$value" || echo "'$value'")
  yaml+="\n- name: $key\n  value: $value"
done

echo -e "$yaml"
